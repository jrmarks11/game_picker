<header class="px-4 sm:px-6 lg:px-8 bg-white shadow">
  <nav class="flex items-center justify-between h-16">
    <div class="flex items-center">
      <div class="flex items-baseline space-x-4">
        <.link
          navigate="/"
          class={[
            "px-3 py-2 rounded-md text-sm font-medium transition-colors",
            if(assigns[:socket] && @socket.view == GamePickerWeb.GameLive.Index,
              do: "bg-indigo-600 text-white",
              else: "text-gray-900 hover:bg-gray-100 hover:text-gray-900"
            )
          ]}
        >
          🎮 Game Picker
        </.link>
        <.link
          navigate="/rocket"
          class={[
            "px-3 py-2 rounded-md text-sm font-medium transition-colors",
            if(assigns[:socket] && @socket.view == GamePickerWeb.RocketLive.Index,
              do: "bg-indigo-600 text-white",
              else: "text-gray-900 hover:bg-gray-100 hover:text-gray-900"
            )
          ]}
        >
          🚀 Rocket Simulation
        </.link>
      </div>
    </div>
  </nav>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
